// script
use coref::java::*

fn default_java_db() -> JavaDB {
    return JavaDB::load("coref_java_src.db")
}

// -------- source --------
fn is_source_stmt(s: Statement) -> bool {
    let (t = s.getPrintableText()) {
        return
            t.contains(".getParameter(") ||
            t.contains(".getHeader(") ||
            t.contains(".getQueryString(")
    }
}

fn source_points(srcFile: string, srcLine: int, methodSig: string) -> bool {
    for (s in Statement(default_java_db())) {
        if (is_source_stmt(s)) {
            let (loc = s.getLocation()) {
                let (m = s.getEnclosingCallable()) {
                    if (
                        srcFile = loc.getFile().getRelativePath() &&
                        srcLine = loc.getStartLineNumber() &&
                        methodSig = m.getSignature()
                    ) {
                        return true
                    }
                }
            }
        }
    }
}

// -------- sink --------
fn is_sink_stmt(s: Statement) -> bool {
    let (t = s.getPrintableText()) {
        return
            t.contains("FileInputStream") ||
            t.contains("FileOutputStream")
    }
}

fn sink_points(sinkFile: string, sinkLine: int, methodSig: string) -> bool {
    for (s in Statement(default_java_db())) {
        if (is_sink_stmt(s)) {
            let (loc = s.getLocation()) {
                let (m = s.getEnclosingCallable()) {
                    if (
                        sinkFile = loc.getFile().getRelativePath() &&
                        sinkLine = loc.getStartLineNumber() &&
                        methodSig = m.getSignature()
                    ) {
                        return true
                    }
                }
            }
        }
    }
}


fn findings_short(
    ruleId: string,
    srcFile: string,
    srcLine: int,
    sinkFile: string,
    sinkLine: int,
    methodSig: string
) -> bool {

    if (
        ruleId = "CWE-022" &&
        source_points(srcFile, srcLine, methodSig) &&
        sink_points(sinkFile, sinkLine, methodSig) &&
        srcFile = sinkFile &&
        srcLine <= sinkLine
    ) {
        return true
    }
}

fn main() {
    output(findings_short())
}