use coref::java::*

// ----------------------------
// CWE-022 Source patterns (MVP)
// 只用文本匹配先跑通；后续再升级成 AST call 匹配
// ----------------------------
fn is_source_stmt_text(t: string) -> bool {
    return
        t.contains(".getParameter(") ||
        t.contains(".getParameterValues(") ||
        t.contains(".getHeader(") ||
        t.contains(".getHeaders(") ||
        t.contains(".getQueryString(") ||
        t.contains(".getPathInfo(") ||
        t.contains(".getCookies(") ||
        t.contains(".getValue(")
}

// 输出：file / line / stmt / methodSig
fn sources(file: string, line: int, stmt: string, methodSig: string) -> bool {
    for (s in ExpressionStatement(default_java_db())) {

        // 关键：txt 在这里就先绑定（ground）
        let (txt = s.getPrintableText()) {

            if (is_source_stmt_text(txt)) {

                let (loc = s.getLocation()) {
                    let (m = s.getEnclosingCallable()) {

                        // 关键：把输出变量都绑定到已ground的 RHS
                        if (
                            file = loc.getFile().getRelativePath() &&
                            line = loc.getStartLineNumber() &&
                            stmt = txt &&
                            methodSig = m.getSignature()
                        ) {
                            return true
                        }
                    }
                }
            }
        }
    }
    return false
}

fn main() {
    output(sources())
}