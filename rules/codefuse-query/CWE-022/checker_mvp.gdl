// script
use coref::java::*

fn default_java_db() -> JavaDB {
    return JavaDB::load("coref_java_src.db")
}

// -------------------- Source (Statement-level) --------------------
// 先做 MVP：把最常见的用户输入点抓住，避免 getRequestURI 这种超吵的
fn is_source_stmt(s: Statement) -> bool {
    let (t = s.getPrintableText()) {
        return
            t.contains(".getParameter(") ||
            t.contains(".getParameterValues(") ||
            t.contains(".getHeader(") ||
            t.contains(".getHeaders(") ||
            t.contains(".getQueryString(") ||
            t.contains(".getPathInfo(") ||
            t.contains(".getValue(")
    }
}

fn source_points(
    srcFile: string, srcLine: int, srcStmt: string, methodSig: string
) -> bool {
    for (s in Statement(default_java_db())) {
        if (is_source_stmt(s)) {
            let (loc = s.getLocation()) {
                let (m = s.getEnclosingCallable()) {
                    if (
                        srcFile = loc.getFile().getRelativePath() &&
                        srcLine = loc.getStartLineNumber() &&
                        srcStmt = s.getPrintableText() &&
                        methodSig = m.getSignature()
                    ) {
                        return true
                    }
                }
            }
        }
    }
}

// -------------------- Sink (Statement-level) --------------------
// 扩展 CWE-22 常见文件系统 sink（先用 printableText 文本匹配 MVP）
fn is_sink_stmt(s: Statement) -> bool {
    let (t = s.getPrintableText()) {
        return
            // classic java.io
            t.contains("new java.io.FileInputStream") ||
            t.contains("new java.io.FileOutputStream") ||
            t.contains("new java.io.FileReader") ||
            t.contains("new java.io.FileWriter") ||
            t.contains("new java.io.RandomAccessFile") ||

            // java.nio.file Files
            t.contains("java.nio.file.Files.newInputStream") ||
            t.contains("java.nio.file.Files.newOutputStream") ||
            t.contains("java.nio.file.Files.readAllBytes") ||
            t.contains("java.nio.file.Files.readAllLines") ||
            t.contains("java.nio.file.Files.write") ||
            t.contains("java.nio.file.Files.readString") ||

            // Path/Paths often precede file access (keep, but can be noisy)
            t.contains("java.nio.file.Paths.get") ||
            t.contains("java.nio.file.Path.of") ||

            // java.io.File usage that often implies path handling
            t.contains("new java.io.File(") ||

            // zip file open (sometimes treated as path traversal sink)
            t.contains("new java.util.zip.ZipFile(")
    }
}

fn sink_points(
    sinkFile: string, sinkLine: int, sinkStmt: string, methodSig: string
) -> bool {
    for (s in Statement(default_java_db())) {
        if (is_sink_stmt(s)) {
            let (loc = s.getLocation()) {
                let (m = s.getEnclosingCallable()) {
                    if (
                        sinkFile = loc.getFile().getRelativePath() &&
                        sinkLine = loc.getStartLineNumber() &&
                        sinkStmt = s.getPrintableText() &&
                        methodSig = m.getSignature()
                    ) {
                        return true
                    }
                }
            }
        }
    }
}

// -------------------- Checker v2: same methodSig join --------------------
fn cwe022_findings(
    ruleId: string,
    srcFile: string, srcLine: int, srcStmt: string,
    sinkFile: string, sinkLine: int, sinkStmt: string,
    methodSig: string
) -> bool {
    if (
        ruleId = "CWE-022" &&

        source_points(srcFile, srcLine, srcStmt, methodSig) &&
        sink_points(sinkFile, sinkLine, sinkStmt, methodSig) &&

        // 弱约束：同文件、source 在 sink 之前（减少一点乱配）
        srcFile = sinkFile &&
        srcLine <= sinkLine
    ) {
        return true
    }
}

fn main() {
    output(cwe022_findings())
}