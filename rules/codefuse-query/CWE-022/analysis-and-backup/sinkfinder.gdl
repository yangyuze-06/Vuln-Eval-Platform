// script
use coref::java::*

fn default_java_db() -> JavaDB {
    return JavaDB::load("coref_java_src.db")
}

// 命中 sink：语句文本包含 “new java.io.FileInputStream”
fn is_fileinputstream_new_stmt(s: ExpressionStatement) -> bool {
    let (t = s.getPrintableText()) {
        // 你的代码里就是 new java.io.FileInputStream(...)
        return t.contains("new java.io.FileInputStream")
    }
}

// 输出：文件 + 行号 + 语句文本 + 所在方法签名
fn sink_fileinputstream(file: string, line: int, stmt: string, methodSig: string) -> bool {
    for (s in ExpressionStatement(default_java_db())) {
        if (is_fileinputstream_new_stmt(s)) {
            let (loc = s.getLocation()) {
                let (m = s.getEnclosingCallable()) {
                    if (
                        file = loc.getFile().getRelativePath() &&
                        line = loc.getStartLineNumber() &&
                        stmt = s.getPrintableText() &&
                        methodSig = m.getSignature()
                    ) {
                        return true
                    }
                }
            }
        }
    }
}

fn main() {
    output(sink_fileinputstream())
}