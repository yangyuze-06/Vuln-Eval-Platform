// script
use coref::java::*
use security::java::JavaServletSources::*
use security::java::TaintHelpers::*
use security::java::TaintTracking::*
use security::java::sanitizers::PathTraversalSanitizers::*
use security::java::sinks::PathTraversalSinks::*

fn default_java_db() -> JavaDB {
    return JavaDB::load("coref_java_src.db")
}

// -------------------------
// Source modeling
// -------------------------
fn is_http_source_call(c: MethodAccessExpression) -> bool {
    return isServletTaintSourceCall(c)
}

fn is_source_expr(e: Expression) -> bool {
    return isServletTaintSourceExpr(e)
}

fn is_source_stmt(s: Statement) -> bool {
    return isServletTaintSourceStmt(s)
}

// Header enumeration flow:
//   request.getHeaderNames() -> Enumeration<headerName>
//   enumeration.nextElement() -> header name
//   request.getHeaders(headerName) -> Enumeration<headerValue>
//   enumeration.nextElement() -> header value
fn is_header_name_enumeration_call(c: MethodAccessExpression) -> bool {
    return isHeaderNameEnumerationCall(c)
}

fn is_header_value_enumeration_call(c: MethodAccessExpression) -> bool {
    return isHeaderValueEnumerationCall(c)
}

fn is_enumeration_next_element_call(c: MethodAccessExpression) -> bool {
    return isEnumerationNextElementCall(c)
}

fn is_header_name_enumeration_source_expr(e: Expression) -> bool {
    return isHeaderNameEnumerationSourceExpr(e)
}

fn is_header_enumeration_next_element_expr(e: Expression) -> bool {
    for (c in MethodAccessExpression(default_java_db())) {
        if (
            e.key_eq(c) &&
            is_enumeration_next_element_call(c) &&
            call_has_tainted_receiver(c)
        ) {
            return true
        }
    }
}

fn is_header_value_enumeration_expr(e: Expression) -> bool {
    for (c in MethodAccessExpression(default_java_db())) {
        if (
            e.key_eq(c) &&
            is_header_value_enumeration_call(c) &&
            call_has_tainted_argument(c)
        ) {
            return true
        }
    }
}

// -------------------------
// Sink modeling
// -------------------------
fn is_path_sink_new(n: NewExpression) -> bool {
    return isPathSinkNew(n)
}

fn is_path_sink_call(c: MethodAccessExpression) -> bool {
    return isPathSinkCall(c)
}

// -------------------------
// Sanitizer/barrier modeling
// -------------------------
fn is_path_sanitizer_call(c: MethodAccessExpression) -> bool { return isPathTraversalSanitizerCall(c) }
fn is_path_sanitizer_expr(e: Expression) -> bool { return isPathTraversalSanitizerExpr(e) }
fn is_path_barrier_call(c: MethodAccessExpression) -> bool { return isPathTraversalBarrierCall(c) }
fn is_path_barrier_expr(e: Expression) -> bool { return isPathTraversalBarrierExpr(e) }

// -------------------------
// Helpers
// -------------------------
fn call_has_tainted_argument(c: MethodAccessExpression) -> bool {
    return callHasTaintedArgument(c)
}

fn call_has_tainted_receiver(c: MethodAccessExpression) -> bool {
    return callHasTaintedReceiver(c)
}

fn new_has_tainted_argument(n: NewExpression) -> bool {
    return newHasTaintedArgument(n)
}

fn call_targets_callable(c: MethodAccessExpression, callee: Callable) -> bool {
    return callTargetsCallable(c, callee)
}

// -------------------------
// Taint propagation
// -------------------------
fn is_tainted_var(v: Variable) -> bool {
    return isTaintedVar(v)
}

fn is_tainted_expr(e: Expression) -> bool {
    return isTaintedExpr(e)
}

// -------------------------
// Findings
// -------------------------
fn cwe022_taint_findings(
    ruleId: string,
    sinkFile: string,
    line: int
) -> bool {
    // New-expression sinks
    for (n in NewExpression(default_java_db())) {
        if (is_path_sink_new(n)) {
            let (loc = n.getLocation()) {
                let (owner = n.getEnclosingCallable()) {
                    let (f = loc.getFile().getRelativePath()) {
                        let (l = loc.getStartLineNumber()) {
                            if (
                                ruleId = "CWE-022" &&
                                sinkFile = f &&
                                line = l
                            ) {
                                if (new_has_tainted_argument(n)) {
                                    return true
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Method-call sinks
    for (c in MethodAccessExpression(default_java_db())) {
        if (is_path_sink_call(c)) {
            let (loc = c.getLocation()) {
                let (owner = c.getEnclosingCallable()) {
                    let (f = loc.getFile().getRelativePath()) {
                        let (l = loc.getStartLineNumber()) {
                            if (
                                ruleId = "CWE-022" &&
                                sinkFile = f &&
                                line = l
                            ) {
                                if (call_has_tainted_argument(c)) {
                                    return true
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn main() {
    output(cwe022_taint_findings())
}
