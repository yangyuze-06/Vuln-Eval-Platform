// script
use coref::java::*
use security::java::JavaServletSources::*
use security::java::TaintHelpers::*
use security::java::TaintTracking::*
use security::java::sanitizers::XssSanitizers::*
use security::java::sinks::XssSinks::*

fn default_java_db() -> JavaDB {
    return JavaDB::load("coref_java_src.db")
}

// -------------------------
// Source modeling
// -------------------------
fn is_http_source_call(c: MethodAccessExpression) -> bool {
    return isServletXssTaintSourceCall(c)
}

fn is_source_expr(e: Expression) -> bool {
    return isServletXssTaintSourceExpr(e)
}

fn is_source_stmt(s: Statement) -> bool {
    return isServletXssTaintSourceStmt(s)
}

// Header enumeration flow:
// request.getHeaderNames() -> names.nextElement() -> request.getHeaders(name)
// -> values.nextElement()
fn is_header_name_enumeration_call(c: MethodAccessExpression) -> bool {
    return isHeaderNameEnumerationCall(c)
}

fn is_header_value_enumeration_call(c: MethodAccessExpression) -> bool {
    return isHeaderValueEnumerationCall(c)
}

fn is_enumeration_next_element_call(c: MethodAccessExpression) -> bool {
    return isEnumerationNextElementCall(c)
}

fn is_header_name_enumeration_source_expr(e: Expression) -> bool {
    return isHeaderNameEnumerationSourceExpr(e)
}

fn is_header_enumeration_next_element_expr(e: Expression) -> bool {
    for (c in MethodAccessExpression(default_java_db())) {
        if (
            e.key_eq(c) &&
            is_enumeration_next_element_call(c) &&
            call_has_tainted_receiver(c)
        ) {
            return true
        }
    }
}

fn is_header_value_enumeration_expr(e: Expression) -> bool {
    for (c in MethodAccessExpression(default_java_db())) {
        if (
            e.key_eq(c) &&
            is_header_value_enumeration_call(c) &&
            call_has_tainted_argument(c)
        ) {
            return true
        }
    }
}

// -------------------------
// Sink modeling
// -------------------------
fn is_potential_xss_sink_call(c: MethodAccessExpression) -> bool {
    return isPotentialXssSinkCall(c)
}

fn is_non_web_sink_call(c: MethodAccessExpression) -> bool {
    return isNonWebSinkCall(c)
}

fn is_web_response_sink_call(c: MethodAccessExpression) -> bool {
    return isWebResponseSinkCall(c)
}

fn is_xss_sink_call(c: MethodAccessExpression) -> bool {
    return isXssSinkCall(c)
}

// -------------------------
// Sanitizer modeling
// -------------------------
fn is_xss_sanitizer_call(c: MethodAccessExpression) -> bool { return isXssSanitizerCall(c) }
fn is_sanitizer_expr(e: Expression) -> bool { return isXssSanitizerExpr(e) }
fn var_has_sanitized_value(v: Variable) -> bool { return xssVarHasSanitizedValue(v) }
fn is_sanitized_return_expr(e: Expression) -> bool { return isXssSanitizedReturnExpr(e) }
fn method_has_sanitized_return(m: Method) -> bool { return xssMethodHasSanitizedReturn(m) }
fn method_has_unsanitized_return(m: Method) -> bool { return xssMethodHasUnsanitizedReturn(m) }
fn is_sanitized_return_method(m: Method) -> bool { return isXssSanitizedReturnMethod(m) }
fn is_sanitized_call_result(c: MethodAccessExpression) -> bool { return isXssSanitizedCallResult(c) }

// -------------------------
// Non-XSS domain result barriers
// -------------------------
fn is_sql_jdbc_domain_call(c: MethodAccessExpression) -> bool { return isSqlJdbcDomainCall(c) }
fn is_ldap_jndi_domain_call(c: MethodAccessExpression) -> bool { return isLdapJndiDomainCall(c) }
fn is_xpath_xml_dom_domain_call(c: MethodAccessExpression) -> bool { return isXpathXmlDomDomainCall(c) }
fn is_non_xss_domain_call_result(c: MethodAccessExpression) -> bool { return isNonXssDomainCallResult(c) }
fn is_non_xss_domain_expr(e: Expression) -> bool { return isNonXssDomainExpr(e) }

// -------------------------
// Generic helpers
// -------------------------
fn call_has_tainted_argument(c: MethodAccessExpression) -> bool {
    return xssCallHasTaintedArgument(c)
}

fn call_has_tainted_receiver(c: MethodAccessExpression) -> bool {
    return xssCallHasTaintedReceiver(c)
}

fn new_has_tainted_argument(n: NewExpression) -> bool {
    return xssNewHasTaintedArgument(n)
}

fn call_targets_callable(c: MethodAccessExpression, callee: Callable) -> bool {
    return callTargetsCallable(c, callee)
}

// -------------------------
// Taint propagation
// -------------------------
fn is_tainted_var(v: Variable) -> bool {
    return isXssTaintedVar(v)
}

fn is_tainted_expr(e: Expression) -> bool {
    return isXssTaintedExpr(e)
}

// -------------------------
// Findings
// -------------------------
fn cwe079_xss_findings(
    ruleId: string,
    sinkFile: string,
    line: int
) -> bool {
    for (c in MethodAccessExpression(default_java_db())) {
        if (is_xss_sink_call(c)) {
            let (loc = c.getLocation()) {
                let (f = loc.getFile().getRelativePath()) {
                    let (l = loc.getStartLineNumber()) {
                        if (
                            ruleId = "CWE-079" &&
                            sinkFile = f &&
                            line = l
                        ) {
                            if (call_has_tainted_argument(c)) {
                                return true
                            }
                            if (call_has_tainted_receiver(c)) {
                                return true
                            }
                        }
                    }
                }
            }
        }
    }
}

fn main() {
    output(cwe079_xss_findings())
}
