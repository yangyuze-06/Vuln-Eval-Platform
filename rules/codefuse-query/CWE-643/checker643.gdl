// script
use coref::java::*
use security::java::JavaServletSources::*
use security::java::TaintHelpers::*
use security::java::TaintTracking::*
use security::java::sanitizers::XPathInjectionSanitizers::*
use security::java::sinks::XPathInjectionSinks::*

fn default_java_db() -> JavaDB {
    return JavaDB::load("coref_java_src.db")
}

// -------------------------
// Source modeling
// -------------------------
fn is_cwe643_source_expr(e: Expression) -> bool {
    return isServletTaintSourceExpr(e)
}

fn is_cwe643_source_stmt(s: Statement) -> bool {
    return isServletTaintSourceStmt(s)
}

fn is_cwe643_source_call(c: MethodAccessExpression) -> bool {
    return isServletTaintSourceCall(c)
}

// -------------------------
// Sink modeling
// -------------------------
fn is_xpath_evaluate_call(c: MethodAccessExpression) -> bool {
    return isXPathEvaluateCall(c)
}

fn is_xpath_compile_call(c: MethodAccessExpression) -> bool {
    return isXPathCompileCall(c)
}

fn is_xpath_sink_call(c: MethodAccessExpression) -> bool {
    return isXPathInjectionSinkCall(c)
}

fn is_xpath_sink_expr(e: Expression) -> bool {
    return isXPathInjectionSinkExpr(e)
}

// -------------------------
// Sanitizer/barrier modeling
// -------------------------
fn is_xpath_sanitizer_call(c: MethodAccessExpression) -> bool {
    return isXPathInjectionSanitizerCall(c)
}

fn is_xpath_sanitizer_expr(e: Expression) -> bool {
    return isXPathInjectionSanitizerExpr(e)
}

fn is_xpath_barrier_call(c: MethodAccessExpression) -> bool {
    return isXPathInjectionBarrierCall(c)
}

fn is_xpath_barrier_expr(e: Expression) -> bool {
    return isXPathInjectionBarrierExpr(e)
}

// -------------------------
// Helpers
// -------------------------
fn call_has_tainted_argument(c: MethodAccessExpression) -> bool {
    return callHasTaintedArgument(c)
}

// -------------------------
// Findings
// -------------------------
fn cwe643_xpath_findings(
    ruleId: string,
    sinkFile: string,
    line: int
) -> bool {
    for (c in MethodAccessExpression(default_java_db())) {
        if (is_xpath_sink_call(c)) {
            let (loc = c.getLocation()) {
                let (f = loc.getFile().getRelativePath()) {
                    let (l = loc.getStartLineNumber()) {
                        if (
                            ruleId = "CWE-643" &&
                            sinkFile = f &&
                            line = l
                        ) {
                            if (
                                call_has_tainted_argument(c) &&
                                !is_xpath_sanitizer_call(c)
                            ) {
                                return true
                            }
                        }
                    }
                }
            }
        }
    }
}

fn main() {
    output(cwe643_xpath_findings())
}
